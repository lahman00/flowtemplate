    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:data": "tsx scripts/validate-data.ts",
    "maintenance": "tsx scripts/maintenance/run-all.ts",
    "maintenance:links": "tsx scripts/maintenance/links.ts",
    "maintenance:freshness": "tsx scripts/maintenance/freshness.ts",
    "maintenance:seo": "tsx scripts/maintenance/seo.ts",
    "maintenance:recommendations": "tsx scripts/maintenance/recommendations.ts",
    "maintenance:comparisons": "tsx scripts/maintenance/comparisons.ts",
    "maintenance:affiliate": "tsx scripts/maintenance/affiliate.ts",
    "agents:quick": "tsx scripts/agents/run.ts --mode=quick",
    "agents:daily": "tsx scripts/agents/run.ts --mode=daily",
    "agents:weekly": "tsx scripts/agents/run.ts --mode=weekly",
    "agents:full": "tsx scripts/agents/run.ts --mode=full",
    "test": "vitest run"
