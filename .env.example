# Copy to .env and fill in only what you actually use. Every variable below
# is optional — the site works with none of them set, exactly as it does in
# this repository today.

# --- Site ---------------------------------------------------------------
# Canonical site URL, used for metadata, canonical links, JSON-LD, and the
# sitemap. Falls back to http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=

# --- Analytics (lib/analytics.ts) ----------------------------------------
# Off by default. Set NEXT_PUBLIC_ANALYTICS_PROVIDER to one of "ga",
# "plausible", or "posthog" AND that provider's required variable below —
# if the provider's ID is missing, analytics stays off regardless of this
# setting.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Required if NEXT_PUBLIC_ANALYTICS_PROVIDER=ga
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required if NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Required if NEXT_PUBLIC_ANALYTICS_PROVIDER=posthog
NEXT_PUBLIC_POSTHOG_KEY=
# Optional, defaults to https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# --- Affiliate tracking (lib/affiliate.ts) -------------------------------
# Optional tracking parameter appended only to genuine affiliate links
# (never to plain official-site links). No effect unless an entry in
# data/software/*.json also sets its own affiliate_url.
NEXT_PUBLIC_AFFILIATE_REF=

# --- Affiliate activation (Sprint 9 — lib/revenue/affiliate-activation.ts) -
# Set ONLY after a real application is approved and the network has issued
# a real tracking link — see docs/affiliate-applications.md. Each is
# ignored unless data/revenue/affiliate-programs.ts confirms
# programExists: "yes" for that product, even if set. Leave every value
# below empty until you actually have one; config/affiliate-credentials.json
# (gitignored) is an equivalent local-file alternative to these env vars.
NEXT_PUBLIC_AFFILIATE_URL_CLICKUP=
NEXT_PUBLIC_AFFILIATE_ID_CLICKUP=
NEXT_PUBLIC_AFFILIATE_URL_ASANA=
NEXT_PUBLIC_AFFILIATE_ID_ASANA=
NEXT_PUBLIC_AFFILIATE_URL_NOTION=
NEXT_PUBLIC_AFFILIATE_ID_NOTION=
NEXT_PUBLIC_AFFILIATE_URL_MONDAY=
NEXT_PUBLIC_AFFILIATE_ID_MONDAY=
NEXT_PUBLIC_AFFILIATE_URL_HUBSPOT=
NEXT_PUBLIC_AFFILIATE_ID_HUBSPOT=
NEXT_PUBLIC_AFFILIATE_URL_PIPEDRIVE=
NEXT_PUBLIC_AFFILIATE_ID_PIPEDRIVE=

# --- Revenue outbound tracking (lib/revenue/events.ts) -------------------
# Off by default. Set to "true" to record real outbound CTA clicks (product,
# official-vs-affiliate, source page, timestamp) to var/outbound-clicks.json
# — a local, first-party file, no third-party analytics involved. Surfaced
# at /internal/outbound-clicks (noindex, not linked from the site). Turning
# this on is a real behavior change for site visitors — see docs/revenue.md
# for the privacy-policy prerequisite before enabling it in production.
NEXT_PUBLIC_REVENUE_TRACKING_ENABLED=
